{
  "name": "flowcheckout",
  "version": "1.0.0",
  "description": "Checkout PIX próprio com gateway MisticPay, painel administrativo e banco Supabase",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "admin:create": "node scripts/create-admin.js",
    "db:check": "node scripts/check-db.js",
    "gen:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "gen:path": "node -e \"console.log(require('crypto').randomBytes(9).toString('base64url'))\"",
    "gen:key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "qrcode": "^1.5.4"
  }
}
