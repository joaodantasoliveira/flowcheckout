# =====================================================================
#  Copie para .env e preencha. NUNCA versione o .env.
#  Na Vercel, cadastre cada variavel em Settings -> Environment Variables.
# =====================================================================

# ---------------------------------------------------------------------
#  SUPABASE
# ---------------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Use a chave SECRETA (service_role), em Project Settings -> API Keys.
# NAO use a publishable/anon: ela e a chave publica do browser e respeita
# RLS — com ela a aplicacao nao consegue ler nem gravar nada.
SUPABASE_SECRET_KEY=sb_secret_...

# ---------------------------------------------------------------------
#  MISTICPAY
# ---------------------------------------------------------------------
MISTICPAY_BASE_URL=https://api.misticpay.com/api
MISTICPAY_CI=seu_client_id
MISTICPAY_CS=seu_client_secret

# ---------------------------------------------------------------------
#  SERVIDOR
# ---------------------------------------------------------------------
PORT=3000

# URL publica da aplicacao. Usada para montar a URL do webhook.
# Local com tunel:  ngrok http 3000
# Na Vercel:        https://seu-projeto.vercel.app
PUBLIC_URL=http://localhost:3000

# Token secreto no caminho da URL do webhook.  Gere:  npm run gen:secret
WEBHOOK_TOKEN=

# ---------------------------------------------------------------------
#  PAINEL ADMINISTRATIVO
# ---------------------------------------------------------------------

# Prefixo secreto onde o painel responde. Qualquer outro caminho da 404.
# Gere:  npm run gen:path
# Corta ruido de scanner automatico. NAO substitui a autenticacao —
# subdominio e caminho vazam por Certificate Transparency e DNS passivo.
ADMIN_PATH=

# Opcional: restringe o painel a um host especifico.
# ADMIN_HOST=painel-x7k2m9.seudominio.com

# Opcional e a defesa mais forte: allowlist de IPs (separados por virgula).
# ADMIN_IP_ALLOWLIST=203.0.113.10,198.51.100.4

# ---------------------------------------------------------------------
#  CRON (limpeza diaria na Vercel)
# ---------------------------------------------------------------------
# Gere:  npm run gen:secret
CRON_SECRET=

# ---------------------------------------------------------------------
#  SPLIT (opcional) — divisao de comissao na MisticPay
# ---------------------------------------------------------------------
# SPLIT_USER=parceiro@email.com
# SPLIT_TAX=10
